{
  "name": "GBKTab – Bookmark New Tab",
  "description": "Modern bookmark-based new tab page with beautifully optimized website icons and lightning-fast bookmark search.",
  "version": "0.5.2",
  "default_locale": "en",
  "manifest_version": 3,
  "host_permissions": [
    "*://*/"
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "favicon"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "24": "assets/icons/icon-24.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "64": "assets/icons/icon-64.png",
    "128": "assets/icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "/index.html#/?target=new-tab"
  },
  "action": {
    "default_popup": "/index.html#/?target=popup"
  },
  "options_page": "options.html",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
