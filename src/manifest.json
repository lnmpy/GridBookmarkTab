{
  "name": "GBKTab – Bookmark New Tab",
  "description": "The bookmark dashboard built for power users. Stop digging through Chrome's bookmark menu. Instantly browse, search, and organize thousands of bookmarks directly from every new tab.",
  "version": "0.3.16",
  "default_locale": "en",
  "manifest_version": 3,
  "host_permissions": [
    "*://*/"
  ],
  "permissions": [
    "bookmarks",
    "storage",
    "unlimitedStorage",
    "tabs",
    "tabGroups",
    "favicon"
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "24": "assets/icons/icon-24.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "64": "assets/icons/icon-64.png",
    "128": "assets/icons/icon-128.png"
  },
  "chrome_url_overrides": {
    "newtab": "/index.html#/?target=new-tab"
  },
  "action": {
    "default_popup": "/index.html#/?target=popup"
  },
  "options_page": "/index.html#/?target=popup"
}